    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.2.1",
