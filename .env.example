# Copy to .env.local for local work. Never commit real secrets.
APP_URL=http://localhost:3000
# PostgreSQL connection from your database provider. Use SSL in production.
DATABASE_URL=
# Only needed when running npm run db:setup, remove password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true ONLY on the canonical production deployment after launch checks.
SEO_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
# Resend: authenticated sender domain; replies go to ulicznyabsurd@gmail.com.
RESEND_API_KEY=
EMAIL_FROM=ULICZNY ABSURD <zamowienia@ulicznyabsurd.pl>
CONTACT_ENABLED=false
CONTACT_FROM=ULICZNY ABSURD <zamowienia@ulicznyabsurd.pl>
CONTACT_TO=ulicznyabsurd@gmail.com
# Vercel public Blob store (product images only)
BLOB_READ_WRITE_TOKEN=
# Random >=32 characters, used by Vercel Cron Authorization bearer header
CRON_SECRET=
# Leave blank until approved Stripe onboarding. Match shop TEST / live mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional destructive integration tests ONLY on an isolated empty test DB.
# TEST_DATABASE_URL=
# TEST_DB_RESET=YES
